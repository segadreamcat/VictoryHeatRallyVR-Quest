function vhr_paint_prebaked(_name) {
    return ds_map_find_value(vhr_paint_table(),_name);
}
// Recoloured driver art for that car, loaded once and kept for the whole session.
function vhr_driver_prebaked(_name) {
    if(!variable_global_exists("vhr_driver_assets")) global.vhr_driver_assets=ds_map_create();
    var _s=ds_map_find_value(global.vhr_driver_assets,_name);
    if(is_undefined(_s) || !sprite_exists(_s)) {
        _s=sprite_add("vhrpaint_"+string_lower(_name)+".png",1,false,false,0,0);
        ds_map_set(global.vhr_driver_assets,_name,_s);
    }
    return _s;
}
// Driver art with the grey background already removed (no per-pixel pass at load).
function vhr_driver_clean_prebaked() {
    if(!variable_global_exists("vhr_driver_clean") || !sprite_exists(global.vhr_driver_clean))
        global.vhr_driver_clean=sprite_add("vhrpaint_vhr-driver-clean.png",1,false,false,0,0);
    return global.vhr_driver_clean;
}
